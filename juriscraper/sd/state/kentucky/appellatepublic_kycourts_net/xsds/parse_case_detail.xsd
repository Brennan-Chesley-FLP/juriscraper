<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for Kentucky C-Track Case Detail Page
  URL: https://appellatepublic.kycourts.net/case/{hash-id}
  Example: https://appellatepublic.kycourts.net/case/755e8a13452bd027d43e60882f6231acf6747270e77652077058ff8744d2ce1a

  Step: parse_case_detail

  IMPORTANT: This page is rendered by a Vue.js SPA. The HTML structure is
  generated by JavaScript after page load. The scraper requires PlaywrightDriver
  to execute JavaScript and render the page content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure
      ==============
      The case detail page contains:
      1. Page heading: "Case View {CASE_NUMBER}"
      2. Details section with case metadata (definition list)
      3. Tab navigation (Docket Entries, Parties, Trial Courts)
      4. Docket entries table
      5. Pagination for docket entries
      6. "Case View Summary" link

      Details Section (Definition List)
      =================================
      The Details section uses dt/dd pairs for metadata:
        dt: "Case Number"    dd: "2018-SC-0250"
        dt: "Title"          dd: "ANTONIO CORDERIERO DOUGLAS VS COMMONWEALTH OF KENTUCKY"
        dt: "Classification" dd: "MATTER OF RIGHT - CRIMINAL - REGULAR CRIMINAL"
        dt: "Filed Date"     dd: "05/22/2018 9:53 AM"
        dt: "Case Status"    dd: "FINAL"
        dt: "Status Date"    dd: "05/09/2019 12:00 AM"
        dt: "Court"          dd: "Kentucky Supreme Court"

      Docket Entries Table
      ====================
      table
        > rowgroup (thead)
          > row (headers)
            > columnheader "Filed Date"
            > columnheader "Description"
            > columnheader "Submitted By"
            > columnheader "Comments"
            > columnheader "Due Date"
            > columnheader "Documents List"
        > rowgroup (tbody)
          > row (for each docket entry)
            > cell (Filed Date: MM/DD/YYYY)
            > cell (Description: "MEMORANDUM OPINION - AFFIRMING", etc.)
            > cell (Submitted By)
            > cell (Comments: Judge participation info)
            > cell (Due Date)
            > cell (Documents List button)

      Documents Modal
      ===============
      When Documents List button is clicked, a modal appears:
        navigation
          > generic "Documents"
          > button "Expand"
          > button "Close"
        table
          > rowgroup
            > row
              > columnheader "Name"
              > columnheader "Description"
              > columnheader "Download link"
          > rowgroup
            > row
              > cell (document name: "2018-SC-000250-MR")
              > cell (description)
              > cell (download link)
                > link "View the document"
                  > /url: /documents/{document-hash}/download

      Scraper XPath Assertions
      ========================
      1. CASE_TITLE: //dt[text()='Title']/following-sibling::dd[1]/text() | //dd[preceding-sibling::dt[1][text()='Title']]/text()
         - Description: "case title"
         - min_count: 0
         - Expected: Case name/title

      2. CLASSIFICATION: //dt[text()='Classification']/following-sibling::dd[1]/text()
         - Description: "classification"
         - min_count: 0
         - Expected: Case type classification

      3. CASE_STATUS: //dt[text()='Case Status']/following-sibling::dd[1]/text()
         - Description: "case status"
         - min_count: 0
         - Expected: "FINAL", "ACTIVE", etc.

      4. COURT: //dt[text()='Court']/following-sibling::dd[1]/text()
         - Description: "court"
         - min_count: 0
         - Expected: "Kentucky Supreme Court" or "Kentucky Court of Appeals"

      5. OPINION_ENTRIES: //table//tbody/tr[td[contains(text(), 'OPINION') or contains(text(), 'MEMORANDUM') or contains(text(), 'ORDER')]]
         - Description: "opinion docket entries"
         - min_count: 0
         - Expected: Rows containing opinion-related entries

      6. DOCUMENT_LINKS: .//a[contains(@href, '/documents/')]/@href
         - Description: "document links"
         - min_count: 0
         - Expected: Links like /documents/{hash}/download

      7. ALL_DOC_LINKS: //a[contains(@href, '/documents/') and contains(@href, '/download')]/@href
         - Description: "all document download links"
         - min_count: 0
         - Expected: All document download links on page

      Sample Case Data
      ================
      Case Number: 2018-SC-0250
      Title: ANTONIO CORDERIERO DOUGLAS VS COMMONWEALTH OF KENTUCKY
      Classification: MATTER OF RIGHT - CRIMINAL - REGULAR CRIMINAL
      Filed Date: 05/22/2018 9:53 AM
      Case Status: FINAL
      Status Date: 05/09/2019 12:00 AM
      Court: Kentucky Supreme Court

      Sample Docket Entry (Opinion)
      ============================
      Filed Date: 04/18/2019
      Description: MEMORANDUM OPINION - AFFIRMING
      Comments: MINTON, C.J.; HUGHES, KELLER, LAMBERT, VANMETER AND WRIGHT, JJ., CONCUR. BUCKINGHAM, J., NOT SITTING. *NOT TO BE PUBLISHED*
      Due Date: 05/08/2019
      Documents: [button] Documents List

      Document Download URL Pattern
      ============================
      /documents/{64-char-hex-hash}/download
      Example: /documents/a39654980597786fb151b12a396ba6bd7133d8f29e83d30c97fa531311f3094a/download
    </xs:documentation>
  </xs:annotation>

  <!-- Root structure -->
  <xs:element name="main">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="heading" type="xs:string">
          <xs:annotation>
            <xs:documentation>Page heading: "Case View {CASE_NUMBER}"</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="details">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="dl" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="dt" type="xs:string"/>
                    <xs:element name="dd" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="docket-entries">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="table">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="rowgroup" minOccurs="2" maxOccurs="2"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
