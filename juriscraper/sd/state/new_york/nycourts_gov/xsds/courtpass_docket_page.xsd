<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for Court-PASS Docket Pages
  URL: https://courtpass.nycourts.gov/Docket.aspx
  Steps: parse_docket_page, fill_docket_search, parse_docket_results,
         parse_docket_detail, parse_docket_detail_for_entry,
         parse_docket_number_results

  Verified against live page 2026-03-10.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure (Docket Search Form — parse_docket_page, fill_docket_search)
      =============================================================================
      ASP.NET WebForms page with form#Form2.
      Behind Cloudflare managed challenge (first load may trigger JS challenge).

      Form fields
      -----------
      Party name search:
        ctl00$cphMain$tbPartyNames        (text)
        ctl00$cphMain$ddlFindPartyName    (select: FindAND / FindOR / Exact)

      Case ID search:
        ctl00$cphMain$ddlCaseId           (select: APL / CTQ / JCR)
        ctl00$cphMain$tbCaseIdYear        (text — 4-digit year)
        ctl00$cphMain$tbCaseIdNum         (text — 5-digit number)

      Submit:
        ctl00$cphMain$btnFind             (submit — "Find")

      Hidden ASP.NET fields:
        __VIEWSTATE, __VIEWSTATEGENERATOR, __VIEWSTATEENCRYPTED,
        __EVENTVALIDATION, __EVENTTARGET, __EVENTARGUMENT, __LASTFOCUS

      Note: The scraper code also checks for a ctl00$cphMain$txtAPL field
      (single text field for APL number) in parse_docket_page.  This field
      does not appear on the current live site; the live form uses
      ddlCaseId + tbCaseIdYear + tbCaseIdNum instead.  The scraper falls
      back to the split fields when txtAPL is not found.

      Docket enumeration (enumerate_dockets) uses:
        tbPartyNames = "a b c d e ... z 0 1 2 ... 9"  (broad OR query)
        ddlFindPartyName = "FindOR"
        → matches every case in the system

      Docket lookup (get_docket) uses:
        txtAPL (if available) or ddlCaseId + tbCaseIdYear + tbCaseIdNum
        → matches a specific case by APL number


      Page Structure (Docket Results — parse_docket_results, parse_docket_number_results)
      =====================================================================================
      After form submission, results appear in a GridView table.

      Results GridView: table#cphMain_gvResults
        Header row: Select | Title | Argument Date
        Data rows (10 per page):
          td[0]: Select button
                 onclick="javascript:__doPostBack('ctl00$cphMain$gvResults','OpenFiles$N')"
          td[1]: Case title (in span#cphMain_gvResults_lbTitle_N)
          td[2]: Argument date (MM/DD/YYYY)

      Pagination row (last tr, same structure as browse):
        Single td with colspan, nested table with page cells:
          Current page: &lt;span&gt;N&lt;/span&gt;
          Other pages:  &lt;a href="javascript:__doPostBack('ctl00$cphMain$gvResults','Page$N')"&gt;N&lt;/a&gt;
          Ellipsis:     &lt;a href="...Page$N..."&gt;...&lt;/a&gt;

      Note: Docket results have 3 columns (Select, Title, Arg Date) vs
      browse results which have 4 (adds Decision Date).

      Lost-context detection:
        Same pattern as browse — when no data rows AND no pagination row
        AND expected_page > 1, re-initiates search via _reinitiate_docket_search().


      Page Structure (Docket Detail — parse_docket_detail, parse_docket_detail_for_entry)
      =====================================================================================
      After selecting a case from results, shows full docket information.
      Form remains form#Form2.

      Detail panel: span#cphMain_lbDetails
        Contains 3 HTML tables (no ASP.NET GridView IDs):

        Table 1 — Case Info:
          &lt;table width="100%"&gt;
            &lt;tr&gt;&lt;td&gt;&lt;b&gt;Title:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Party Name v. Other Party&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;&lt;b&gt;APL No.:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;
              &lt;a href="javascript:CallDetails()"&gt;APL-2024-00177&lt;/a&gt;
            &lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;&lt;b&gt;Argument Date:&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MM/DD/YYYY&lt;/td&gt;&lt;/tr&gt;
          &lt;/table&gt;

          The APL link's javascript:CallDetails() function clicks the hidden
          bttnDetails button, which navigates to the filing detail page.

        Table 2 — FILINGS (optional, may be absent for new cases):
          &lt;table width="100%"&gt;
            &lt;tr&gt;&lt;td colspan="4"&gt;&lt;strong&gt;FILINGS&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Party&lt;/th&gt;&lt;th&gt;Date Due&lt;/th&gt;&lt;th&gt;Date Rec'd&lt;/th&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Appellant Brief&lt;/td&gt;&lt;td&gt;Smith&lt;/td&gt;&lt;td&gt;01/15/2025&lt;/td&gt;&lt;td&gt;01/10/2025&lt;/td&gt;&lt;/tr&gt;
            ...
          &lt;/table&gt;

          Filing types include: Appellant Brief, Respondent Brief, Amicus Brief,
          Reply Brief, Record on Appeal, Appendix, and others.

        Table 3 — ATTORNEY DETAILS:
          &lt;table width="100%"&gt;
            &lt;tr&gt;&lt;td colspan="2"&gt;&lt;strong&gt;ATTORNEY DETAILS&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Party Name:&lt;/td&gt;&lt;td&gt;John Doe&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Party Role:&lt;/td&gt;&lt;td&gt;Appellant&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Firm:&lt;/td&gt;&lt;td&gt;Law Firm LLP&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Attorney:&lt;/td&gt;&lt;td&gt;Jane Smith&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Address:&lt;/td&gt;&lt;td&gt;123 Main St&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;New York, NY 10001&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td&gt;Phone:&lt;/td&gt;&lt;td&gt;(212) 555-1234&lt;/td&gt;&lt;/tr&gt;
            &lt;tr&gt;&lt;td colspan="2" bgcolor="Teal"&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;   (teal divider)
            (next attorney block repeats...)
          &lt;/table&gt;

          Attorney blocks are separated by a teal divider row
          (td colspan="2" with bgcolor="Teal").  Address may span
          multiple rows (continuation row has empty label cell).
          Party roles include: Appellant, Respondent, Amicus Curiae, Intervenor.

      Hidden CallDetails button:
        input[name='ctl00$cphMain$bttnDetails']
        - Style: width:0px (hidden from view)
        - Clicking navigates to the filing detail page (form#Form2,
          span#cphMain_lbDetails2), documented in courtpass_filing_detail.xsd
        - The scraper uses __EVENTTARGET postback (enumerate flow) or
          submit_selector (get_docket flow) to trigger it

      Scraper XPath Assertions
      ========================
      Results:
      1. RESULT_ROWS: //table[contains(@id, 'gvResults')]//tr[position()>1]
         - min_count: 0
      2. PAGINATION_LINKS (per row): .//a[contains(@href, 'Page$')]
         - min_count: 0
      3. CURRENT_PAGE_INDICATOR:
           //table[contains(@id, 'gvResults')]//tr[last()]//td//span[not(ancestor::a)]
         - min_count: 0

      Detail:
      4. APL_LINK: //span[@id='cphMain_lbDetails']//a[contains(text(), 'APL')]//text()
         - min_count: 0
         - Regex: APL-\d{4}-\d{5}
      5. CASE_TITLE: //span[@id='cphMain_lbDetails']/table[1]
                        //tr[td/b[contains(text(),'Title')]]/td[2]//text()
         - min_count: 0
      6. ARG_DATE: //span[@id='cphMain_lbDetails']/table[1]
                     //tr[td/b[contains(text(),'Argument Date')]]/td[2]//text()
         - min_count: 0
         - Regex: \d{2}/\d{2}/\d{4}
      7. FILINGS_TABLE: //span[@id='cphMain_lbDetails']
                          //table[.//strong[contains(text(),'FILINGS')]]
         - min_count: 0
      8. FILING_DATA_ROWS: .//tr[td[not(@colspan)]]
         - min_count: 0 (within filings table)
         - Cells: Type | Party | Date Due | Date Rec'd (4 cells)
      9. ATTORNEY_TABLE: //span[@id='cphMain_lbDetails']
                           //table[.//strong[contains(text(),'ATTORNEY DETAILS')]]
         - min_count: 0
      10. ATTORNEY_ROWS: .//tr
          - min_count: 0 (within attorney table)
          - Label/value pairs in td[0]/td[1]
          - Divider rows: td[colspan="2"] with teal background

      APL Number Format
      =================
      Pattern: APL-YYYY-NNNNN (or CTQ-/JCR- for other case types)
      Example: APL-2024-00177
    </xs:documentation>
  </xs:annotation>

  <xs:element name="html">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" minOccurs="0"/>
        <xs:element name="body" type="bodyType"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!--
    Body contains scripts, divs, navigation elements, and multiple forms
    before the target ASP.NET form.  Uses xs:any to accept the preamble.
  -->
  <xs:complexType name="bodyType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ASP.NET form: id="Form2" -->
  <xs:complexType name="aspnetFormType">
    <xs:sequence>
      <xs:element name="input" type="hiddenFieldType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="div" type="contentPanelType"/>
    </xs:sequence>
    <xs:attribute name="id" fixed="Form2"/>
    <xs:attribute name="method" fixed="post"/>
  </xs:complexType>

  <xs:complexType name="hiddenFieldType">
    <xs:attribute name="type" fixed="hidden"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>

  <!-- Content panel: search form, results table, or detail view -->
  <xs:complexType name="contentPanelType">
    <xs:sequence>
      <!--
        Search form elements, results table (table#cphMain_gvResults),
        or detail span (span#cphMain_lbDetails) depending on page state.
        Uses xs:any because the form elements vary by state.
      -->
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Results GridView: table#cphMain_gvResults

    ASP.NET GridView renders all rows as direct <tr> children (no thead/tbody),
    so we use a single <tr> element with flexible content to satisfy UPA.

    Row types:
      - Header row:     <tr> with <th> cells (Select | Title | Argument Date)
      - Data rows:      <tr> with <td> cells (button, title, arg date)
      - Pagination row: <tr> with single <td colspan> containing nested page-link table
  -->
  <xs:complexType name="resultsGridType">
    <xs:sequence>
      <xs:element name="tr" type="gridRowType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
  </xs:complexType>

  <!-- Flexible row type: accepts <th>, <td>, or nested content -->
  <xs:complexType name="gridRowType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!--
    Docket Detail: span#cphMain_lbDetails
    Contains 1-3 plain HTML tables (no GridView IDs):
      Table 1: Case Info (Title, APL No., Argument Date)
      Table 2: FILINGS (optional)
      Table 3: ATTORNEY DETAILS (optional)
    Uses a single <table> element to satisfy UPA.
  -->
  <xs:complexType name="detailPanelType">
    <xs:sequence>
      <xs:element name="table" type="detailTableType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" fixed="cphMain_lbDetails"/>
  </xs:complexType>

  <!-- Flexible table type for detail panel tables -->
  <xs:complexType name="detailTableType">
    <xs:sequence>
      <xs:element name="tr" type="detailRowType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="width" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Flexible row type for detail tables -->
  <xs:complexType name="detailRowType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="aplLinkType" mixed="true">
    <xs:attribute name="href" type="xs:string"/>
    <!-- href="javascript:CallDetails()" -->
  </xs:complexType>

  <!-- APL number pattern -->
  <xs:simpleType name="aplNumberType">
    <xs:restriction base="xs:string">
      <xs:pattern value="(APL|CTQ|JCR)-\d{4}-\d{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Hidden CallDetails button:
      name="ctl00$cphMain$bttnDetails"
      style="width:0px" (invisible)
  -->
  <xs:complexType name="callDetailsButtonType">
    <xs:attribute name="type" fixed="submit"/>
    <xs:attribute name="name" fixed="ctl00$cphMain$bttnDetails"/>
    <xs:attribute name="value" type="xs:string"/>
    <xs:attribute name="id" fixed="cphMain_bttnDetails"/>
  </xs:complexType>
</xs:schema>
