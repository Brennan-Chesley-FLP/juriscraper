<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for Kentucky C-Track Opinion Search Results Page
  URL: https://appellatepublic.kycourts.net/search/opinion?q=true&advanced=true&p.page=1&p.sort=parentDate&p.sortdir=desc

  Step: parse_opinion_search

  IMPORTANT: This page is rendered by a Vue.js SPA. The HTML structure is
  generated by JavaScript after page load. The scraper requires PlaywrightDriver
  to execute JavaScript and render the page content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure
      ==============
      The opinion search results page contains:
      1. Search form (left side) with case number and date filters
      2. Filters sidebar (left side) showing court and case status facets
      3. Results table (main content area)
      4. Pagination controls (bottom)

      Key Elements
      ============
      - Filters: Court checkboxes for "Kentucky Court of Appeals" and "Kentucky Supreme Court"
      - Results Table: 6 columns (Case Number, Type, Subtype, Description, Filed Date, Documents List)
      - Pagination: Shows "X-Y of Z" with previous/next buttons

      Table Structure (Vue.js rendered)
      =================================
      table
        > rowgroup (thead)
          > row (headers)
            > columnheader "Case Number"
            > columnheader "Type"
            > columnheader "Subtype"
            > columnheader "Description"
            > columnheader "Filed Date"
            > columnheader "Documents List"
        > rowgroup (tbody)
          > row (for each result)
            > cell (Case Number with link)
              > link "Go to case YYYY-XX-NNNN"
                > /url: /case/{hash-id}
            > cell (Type: "DISPOSITION - MEMORANDUM OPINION")
            > cell (Subtype: "AFFIRMING", "REVERSING", etc.)
            > cell (Description)
            > cell (Filed Date: MM/DD/YYYY)
            > cell (Documents List button, if documents exist)

      Scraper XPath Assertions
      ========================
      1. OPINION_ROWS: //table//tbody/tr[contains(@class, 'v-data-table__tr')] | //table//tbody[not(@class='v-data-table__progress')]/tr[td]
         - Description: "opinion result rows"
         - min_count: 0
         - Expected: List of result row elements

      2. ROW_CELLS: td
         - Description: "row cells"
         - min_count: 5
         - Expected: At least 5 cells per row (Case Number, Type, Subtype, Description, Filed Date)

      3. CASE_LINK: .//a/@href
         - Description: "case link"
         - min_count: 0, max_count: 1
         - Expected: Link to case detail page like /case/{hash-id}

      4. CASE_NUMBER_TEXT: .//a/text() | .//text()
         - Description: "case number text"
         - min_count: 1
         - Expected: Case number like "2024-SC-0123" or "2024-CA-0456"

      5. NEXT_BUTTON: //button[contains(@aria-label, 'Next') and not(@disabled)] | //button[.//text()[contains(., 'chevron_right')] and not(@disabled)]
         - Description: "next page button"
         - min_count: 0, max_count: 1
         - Expected: Next page button if more results exist

      Sample Data
      ===========
      Case Number: 2018-SC-0250
      Type: DISPOSITION - MEMORANDUM OPINION
      Subtype: AFFIRMING
      Description: MEMORANDUM OPINION - AFFIRMING
      Filed Date: 04/18/2019

      Court Filters
      =============
      - Kentucky Court of Appeals (56,444 opinions as of Jan 2026)
      - Kentucky Supreme Court (10,744 opinions as of Jan 2026)
      - Results capped at 10,000 records

      Pagination
      ==========
      - 25 results per page
      - Format: "1-25 of 10,000"
      - Next/Previous buttons with chevron icons
    </xs:documentation>
  </xs:annotation>

  <!-- Root element for the results table -->
  <xs:element name="table">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rowgroup" minOccurs="2" maxOccurs="2">
          <xs:annotation>
            <xs:documentation>First rowgroup is header, second is body</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="row" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="cell" minOccurs="5" maxOccurs="6">
                      <xs:complexType mixed="true">
                        <xs:sequence>
                          <xs:element name="link" minOccurs="0">
                            <xs:complexType>
                              <xs:attribute name="href" type="xs:string"/>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="button" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Documents List button</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
