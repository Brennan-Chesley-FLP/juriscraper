<?xml version="1.0" encoding="UTF-8"?>
<svg viewBox="0 0 959 620" xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink">
  <defs>
    <pattern id="unknown-pattern" patternUnits="userSpaceOnUse"
             width="10" height="10" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="10" stroke="#999" stroke-width="2"/>
    </pattern>
  </defs>

  <style>
    .circuit {
      stroke: #333;
      stroke-width: 1.5;
      cursor: pointer;
      transition: stroke-width 0.2s;
    }
    .circuit:hover {
      stroke: #000;
      stroke-width: 3;
    }
    .covered {
      fill: {{ covered_color }};
    }
    .not-covered {
      fill: #e0e0e0;
    }
    .unknown {
      fill: url(#unknown-pattern);
    }
    .circuit-label {
      font-family: sans-serif;
      font-size: 14px;
      font-weight: bold;
      fill: #fff;
      stroke: #000;
      stroke-width: 0.5px;
      paint-order: stroke fill;
      pointer-events: none;
    }
    .legend-text {
      font-family: sans-serif;
      font-size: 12px;
    }
  </style>

  {% for circuit_num, circuit_data in circuits.items() %}
  <a {% if circuit_data.link %}xlink:href="{{ circuit_data.link }}" href="{{ circuit_data.link }}"{% endif %}>
  <g id="circuit-{{ circuit_num }}"
     class="circuit{% if circuit_data.covered %} covered{% elif circuit_data.unknown %} unknown{% else %} not-covered{% endif %}">
    {% for state_code in circuit_data.state_codes %}
    {% if state_code in states %}
    <path d="{{ states[state_code].path_data }}"
          fill="{{ covered_color if circuit_data.covered else '#e0e0e0' }}"/>
    {% endif %}
    {% endfor %}
    <title>Circuit {{ circuit_num }}{% if circuit_data.covered %}: Covered{% else %}: Not covered{% endif %}</title>
  </g>
  </a>
  {% endfor %}

  {% for circuit_num, label_pos in circuit_labels.items() %}
  <text x="{{ label_pos.x }}" y="{{ label_pos.y }}" class="circuit-label">{{ circuit_num }}</text>
  {% endfor %}

  <!-- Legend -->
  <g transform="translate(700, 40)">
    <text x="0" y="0" class="legend-text" font-weight="bold">{{ title }}</text>
    <rect x="0" y="10" width="20" height="15" fill="{{ covered_color }}" stroke="#000"/>
    <text x="25" y="23" class="legend-text">Covered</text>
    <rect x="0" y="35" width="20" height="15" fill="#e0e0e0" stroke="#000"/>
    <text x="25" y="48" class="legend-text">Not covered</text>
  </g>
</svg>
