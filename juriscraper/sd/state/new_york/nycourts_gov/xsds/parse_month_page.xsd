<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for NY Court of Appeals Monthly Decisions Page
  URL Pattern: https://www.nycourts.gov/ctapps/Decisions/{YYYY}/{Mon}{YY}/{Month}{YY}.html
  Example: https://www.nycourts.gov/ctapps/Decisions/2025/Dec25/December25.html

  Step: parse_month_page
  XPath used: //table//tr, td, strong/text(), a/@href, .//text()
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure
      ==============
      Monthly decision pages contain a single table with:
      - Date header rows: <td><strong>December 18, 2025</strong></td>
      - Decision List rows: "Decision List" | PDF link | "Entries for Cases and Motions"
      - Opinion rows: "No. NNN" | PDF link | "Case Name"
      - Empty separator rows between decision dates

      Row Types
      =========
      1. DATE HEADER ROW
         - First cell: <strong>December 18, 2025</strong>
         - Other cells empty
         - Regex for date: (\w+)\s+(\d{1,2}),\s+(\d{4})

      2. DECISION LIST ROW
         - First cell: <strong>Decision List</strong>
         - Second cell: <a href="DecisionList121825.pdf">PDF</a>
         - Third cell: <strong>Entries for Cases and Motions</strong>

      3. OPINION ROW
         - First cell: "No. 102" or "No. 105-110" or "No. 128 SSM 3"
         - Second cell: <a href="102mem25-Decision.pdf">PDF</a>
         - Third cell: "Case Name v. Other Party"

      4. SEPARATOR ROW
         - Three empty cells

      Opinion Number Formats
      ======================
      - Simple: "No. 102"
      - Range: "No. 105-110"
      - With SSM: "No. 128 SSM 3"
      - Typo variant: "No .115" (space before period)

      PDF Filename Pattern
      ====================
      Pattern: {number}{type}{year}-Decision.pdf
      Types:
        - opn: Opinion (full written opinion)
        - mem: Memorandum (brief opinion)
        - ent: Entry (order/entry)
      Examples:
        - 112opn26-Decision.pdf
        - 102mem25-Decision.pdf
        - 36ent26-Decision.pdf
        - 105110opn25-Decision.pdf (for ranges)

      Scraper XPath Assertions
      ========================
      1. TABLE_ROWS: //table//tr
         - Description: "table rows"
         - min_count: 0

      2. ROW_CELLS: td
         - Description: "row cells"
         - min_count: 0 (some rows may be empty)

      3. DATE_TEXT: strong/text()
         - Description: "date text"
         - min_count: 0
         - Expected: Date string like "December 18, 2025"

      4. FIRST_CELL_TEXT: .//text()
         - Description: "first cell text"
         - min_count: 0
         - Expected: Opinion number like "No. 102"

      5. PDF_LINK: a/@href
         - Description: "PDF link"
         - min_count: 0
         - Expected: Relative PDF URL

      6. CASE_NAME: .//text()
         - Description: "case name"
         - min_count: 0
         - Expected: Full case name
    </xs:documentation>
  </xs:annotation>

  <!-- Root element is an HTML page -->
  <xs:element name="html">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" minOccurs="0"/>
        <xs:element name="body" type="bodyType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="bodyType">
    <xs:sequence>
      <xs:any processContents="lax" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Table containing decisions -->
  <xs:complexType name="decisionsTableType">
    <xs:sequence>
      <xs:element name="tbody" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="tr" type="decisionRowType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="tr" type="decisionRowType" maxOccurs="unbounded" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Decision row can be date, decision list, opinion, or separator -->
  <xs:complexType name="decisionRowType">
    <xs:sequence>
      <xs:element name="td" type="cellType" minOccurs="0" maxOccurs="3"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Generic cell type -->
  <xs:complexType name="cellType" mixed="true">
    <xs:sequence>
      <xs:element name="strong" type="xs:string" minOccurs="0"/>
      <xs:element name="a" type="pdfLinkType" minOccurs="0"/>
      <xs:element name="p" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- PDF link type -->
  <xs:complexType name="pdfLinkType" mixed="true">
    <xs:attribute name="href" type="pdfUrlType" use="required"/>
  </xs:complexType>

  <!-- PDF URL pattern -->
  <xs:simpleType name="pdfUrlType">
    <xs:restriction base="xs:string">
      <xs:pattern value=".*\.pdf"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Date pattern for strong elements in date rows -->
  <xs:simpleType name="dateStringType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\w+\s+\d{1,2},\s+\d{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Opinion number pattern -->
  <xs:simpleType name="opinionNumberType">
    <xs:restriction base="xs:string">
      <xs:pattern value="No\.?\s*\d+(-\d+)?(\s+SSM\s+\d+)?"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
