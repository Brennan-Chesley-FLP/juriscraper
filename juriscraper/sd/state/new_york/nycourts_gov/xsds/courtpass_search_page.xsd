<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for Court-PASS Public Search Page
  URL: https://courtpass.nycourts.gov/Public_search.aspx
  Steps: fill_search_pending, parse_pending_search_results,
         fill_search_decided_after, parse_decided_search_results

  Verified against live page 2026-03-10.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure (Search Form — fill_search_pending / fill_search_decided_after)
      =================================================================================
      ASP.NET WebForms page with form#Form1 (capital F).
      Behind Cloudflare managed challenge (first load may trigger JS challenge).

      Form fields used by the scraper
      ---------------------------------
      Case-type radio:
        ctl00$cphMain$RadioButtonList1       (radio: Civil / Criminal / All Cases)

      Party name search:
        ctl00$cphMain$txtPartyName           (text)
        ctl00$cphMain$ddlFindPartyName       (select: FindAND / FindOR / Exact)

      Decision date — Telerik RadDatePicker:
        ctl00$cphMain$rdpStartDecisionDate               (text, ISO date)
        ctl00$cphMain$rdpStartDecisionDate$dateInput      (text, MM/DD/YYYY)
        ctl00_cphMain_rdpStartDecisionDate_dateInput_ClientState  (hidden, Telerik JSON)
        ctl00$cphMain$rdpEndDecisionDate                 (text, ISO date)
        ctl00$cphMain$rdpEndDecisionDate$dateInput        (text, MM/DD/YYYY)
        ctl00_cphMain_rdpEndDecisionDate_dateInput_ClientState    (hidden, Telerik JSON)

      Argument date — Telerik RadDatePicker:
        ctl00$cphMain$rdpStartAppealGrantedDate               (text, ISO date)
        ctl00$cphMain$rdpStartAppealGrantedDate$dateInput      (text, MM/DD/YYYY)
        ctl00_cphMain_rdpStartAppealGrantedDate_dateInput_ClientState  (hidden, Telerik JSON)
        ctl00$cphMain$rdpEndAppealGrantedDate                 (text, ISO date)
        ctl00$cphMain$rdpEndAppealGrantedDate$dateInput        (text, MM/DD/YYYY)
        ctl00_cphMain_rdpEndAppealGrantedDate_dateInput_ClientState    (hidden, Telerik JSON)

      Other fields (not used by scraper):
        ctl00$cphMain$txtJudgeName           (text — authoring judge)
        ctl00$cphMain$txtDocketNo            (text — decision number)
        ctl00$cphMain$ddlMainHead            (select — primary classification)
        ctl00$cphMain$ddlSubHead             (select — secondary classification)
        ctl00$cphMain$ddlSlipYear            (select — slip opinion year)
        ctl00$cphMain$txtSlipNo              (text — slip opinion number)
        ctl00$cphMain$txtVolumeNo            (text — official reports volume)
        ctl00$cphMain$txtPageNo              (text — official reports page)

      Submit:
        ctl00$cphMain$btnFind                (submit — "Find")
        ctl00$cphMain$btnReset               (submit — "Reset")

      Hidden ASP.NET fields:
        __VIEWSTATE, __VIEWSTATEGENERATOR, __VIEWSTATEENCRYPTED,
        __EVENTVALIDATION, __EVENTTARGET, __EVENTARGUMENT, __LASTFOCUS,
        cphMain_RadScriptManager1_TSM

      Telerik ClientState JSON format
      --------------------------------
      The server reads dates from the hidden _dateInput_ClientState fields,
      not the visible text inputs.  Format:
        {"enabled":true,"emptyMessage":"","validationText":"YYYY-MM-DD-00-00-00",
         "valueAsString":"YYYY-MM-DD-00-00-00","minDateStr":"1980-01-01-00-00-00",
         "maxDateStr":"9999-12-31-00-00-00","lastSetTextBoxValue":"MM/DD/YYYY"}

      Page Structure (Search Results — parse_pending_search_results / parse_decided_search_results)
      ===============================================================================================
      After form submission, two grids may appear on the same response:

        cphMain_gvPublicSearchPre   — pending cases  (parse_pending_search_results)
          Header row: Select | Title | Calendar Date | Argument Number
        cphMain_gvPublicSearchPost  — decided cases  (parse_decided_search_results)
          Header row: Select | Title | Decision Date | Citation

      Both grids render rows the same way (post-2026-04 redesign):
        td[0]: <input type="submit" id="cphMain_<grid>_btnSelect_N"
                       name="ctl00$cphMain$<grid>$ctl<N+2>$btnSelect"
                       aria-label="Select: <case_name>. <date_label> <date>...">
        td[1..]: case-name + date / argument number / citation cells
        (column header is now wrapped in <thead>; data + pagination rows
         live inside <tbody>)

      Pagination row (last tr):
        Single td with colspan, containing nested table with page links:
          Current page: &lt;span&gt;N&lt;/span&gt;  (plain text, no link)
          Other pages:  &lt;a href="javascript:__doPostBack('ctl00$cphMain$gvPublicSearchPost','Page$N')"&gt;N&lt;/a&gt;
          Ellipsis:     &lt;a href="..."&gt;...&lt;/a&gt;  (link text is "...")

      A "Decided Cases:" label div appears above the table.

      Navigation buttons after the table:
        ctl00$cphMain$bttnSearch   (submit — "Return to Search")

      Scraper XPath Assertions
      ========================
      1. DATA_ROWS:  //table[@id='cphMain_gvPublicSearchPre']
                          //tr[.//input[contains(@id, 'btnSelect')]]
                  OR //table[@id='cphMain_gvPublicSearchPost']
                          //tr[.//input[contains(@id, 'btnSelect')]]
         - min_count: 0
         - Picked by content (the row contains a btnSelect submit) so the
           thead/tbody split doesn't drop the first data row.
      2. PAGINATION_ROW: same table, //tr[.//a[contains(@href, 'Page$')]]
      3. ROW_CELLS: td
         - min_count: 4 (Select button, Title, Date, Citation/Argument#)
    </xs:documentation>
  </xs:annotation>

  <xs:element name="html">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" minOccurs="0"/>
        <xs:element name="body" type="bodyType"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="bodyType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ASP.NET form: id="Form1" (capital F) -->
  <xs:complexType name="aspnetFormType">
    <xs:sequence>
      <xs:element name="input" type="hiddenFieldType" maxOccurs="unbounded"/>
      <xs:element name="div" type="contentPanelType"/>
    </xs:sequence>
    <xs:attribute name="id" fixed="Form1"/>
    <xs:attribute name="method" fixed="post"/>
  </xs:complexType>

  <xs:complexType name="hiddenFieldType">
    <xs:attribute name="type" fixed="hidden"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>

  <!-- Search form fields (simplified) -->
  <xs:complexType name="contentPanelType">
    <xs:sequence>
      <!--
        Search form elements (RadDatePickers, text fields, dropdowns) and
        results table (table#cphMain_gvPublicSearchPost) after submission.
        Uses xs:any because the form elements vary by page state.
      -->
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Results GridView: id="cphMain_gvPublicSearchPost"

    ASP.NET GridView renders all rows as direct <tr> children (no thead/tbody),
    so we use a single <tr> element with flexible content to satisfy UPA.

    Row types:
      - Header row:     <tr> with <th> cells (Select | Title | Decision Date | Citation)
      - Data rows:      <tr> with <td> cells (button, title, date, citation)
      - Pagination row: <tr> with single <td colspan> containing nested page-link table
  -->
  <xs:complexType name="resultsGridType">
    <xs:sequence>
      <xs:element name="tr" type="gridRowType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
  </xs:complexType>

  <!-- Flexible row type: accepts <th>, <td>, or nested content -->
  <xs:complexType name="gridRowType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
</xs:schema>
