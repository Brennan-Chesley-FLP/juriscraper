{
  "schema_version": 1,
  "name": "cloudflare-chrome",
  "description": "Chrome profile for Cloudflare-protected sites. Uses assistantMode + cdpPort to natively hide automation signals.",
  "browser_type": "chromium",
  "channel": "chrome",
  "persistent_context": true,
  "launch_options": {
    "no_viewport": true,
    "ignore_default_args": ["--disable-extensions"]
  },
  "context_options": {
    "locale": "en-US",
    "timezone_id": "America/New_York"
  },
  "protocol_params": {
    "assistantMode": true,
    "cdpPort": "auto"
  },
  "init_scripts": []
}
