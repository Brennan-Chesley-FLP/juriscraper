<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for NYSCEF Document List Page
  URL: https://iapps.courts.state.ny.us/nyscef/DocumentList?docketId={id}&display=all
  Step: parse_document_list
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure (Document List)
      ==============================
      Shows all documents filed in a case. Reached via search result link
      or the "Document List" tab on Case Detail.

      URL patterns:
      - DocumentList?docketId={base64}&amp;display=all&amp;courtType={court}&amp;resultsPageNum=1
      - SearchDocuments?docketId={base64} (from tab link)

      Header: h1.PageHeading
      - "{YYYY-NNNNN} - {Court Name}"

      Case Summary: div.CaseSummary (same as Case Detail page)

      Tabs: div#tabs ul
      - "Document List" (current)
      - "Case Detail" → CaseDetails?docketId=...

      Narrow By Options: filters for document type, filed by, date, doc #

      Sort By: combobox with options (Document Type, Document #, Status, etc.)

      Documents Table: table[summary='all documents for case']
      - Header: # | Document | Filed By | Status
      - Data rows:
        - Cell 0: Document number (integer)
        - Cell 1: Document type as link + optional description text
          - Link: &lt;a href="ViewDocument?docIndex={base64}"&gt;DOC TYPE&lt;/a&gt;
          - Extra text after link (e.g., "Volume 1 of 2", "*Corrected*")
          - Description text (e.g., "Stipulation Adjourning Appeal to September 2024 Term")
        - Cell 2: Filed by name + Filed date + Received date
          - "FILED_BY_NAME\nFiled: MM/DD/YYYY\nReceived: MM/DD/YYYY"
        - Cell 3: Status (strong element) + optional Confirmation Notice link

      ViewDocument URL Pattern
      ========================
      ViewDocument?docIndex={base64}
      - docIndex is an opaque base64-encoded identifier
      - Returns the document content (PDF, DOC, etc.)
      - Direct GET request (no form submission needed)

      Scraper XPath Assertions
      ========================
      1. DOC_ROWS: //table[contains(@summary, 'all documents')]//tr[position()>1]
         - min_count: 0
      2. DOC_LINK: .//a[contains(@href, 'ViewDocument')]
         - min_count: 0 (per row)
      3. STATUS: .//strong
         - min_count: 0 (per row)

      Document Types Observed
      =======================
      - COPY OF NOTICE OF APPEAL WITH PROOF OF FILING / INFORMATIONAL STATEMENT / ORDER OR JDMT APPEALED FROM
      - PROOF OF SERVICE OF NOTIFICATION OF CASE NUMBER
      - RECORD ON APPEAL
      - STATEMENT OF AUTHORIZATION FOR ELECTRONIC FILING
      - APPELLANT'S BRIEF
      - NOTE OF ISSUE
      - STIPULATION -
      - RESPONDENT'S BRIEF
      - LETTER OF UNAVAILABILITY -
      - REPLY BRIEF
      - DECISION AND ORDER
    </xs:documentation>
  </xs:annotation>

  <xs:element name="html">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" minOccurs="0"/>
        <xs:element name="body" type="bodyType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="bodyType">
    <xs:sequence>
      <xs:element name="main" type="mainType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="mainType">
    <xs:sequence>
      <xs:element name="h1" type="xs:string"/>
      <xs:element name="div" type="xs:anyType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="table" type="documentsTableType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="documentsTableType">
    <xs:sequence>
      <xs:element name="thead">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="tr" type="docHeaderRowType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="tbody">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="tr" type="docDataRowType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="summary" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="docHeaderRowType">
    <xs:sequence>
      <xs:element name="th" type="xs:string" maxOccurs="4"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="docDataRowType">
    <xs:sequence>
      <!-- Cell 0: Document number -->
      <xs:element name="td" type="xs:string"/>
      <!-- Cell 1: Document type link + description -->
      <xs:element name="td" type="docCellType"/>
      <!-- Cell 2: Filed by + dates -->
      <xs:element name="td" type="xs:string"/>
      <!-- Cell 3: Status -->
      <xs:element name="td" type="statusCellType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="docCellType" mixed="true">
    <xs:sequence>
      <xs:element name="a" type="docLinkType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="docLinkType" mixed="true">
    <xs:attribute name="href" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="statusCellType" mixed="true">
    <xs:sequence>
      <xs:element name="strong" type="xs:string" minOccurs="0"/>
      <xs:element name="a" minOccurs="0">
        <xs:complexType mixed="true">
          <xs:attribute name="href" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
