<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD Schema for Court-PASS Filing Detail Page
  URL: reached via postback from Search, Browse, or Docket results
  Steps: parse_filing_detail, parse_filing_detail_from_docket,
         parse_docket_filing_detail

  Verified against live page 2026-03-10.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation>
      Page Structure (Filing Detail)
      ===============================
      Reached by clicking "Select" on a case in Search/Browse results,
      or by clicking the CallDetails button from Docket detail.

      The form ID depends on where the user arrived from:
        - From Search:  form#Form1
        - From Browse:  form#Form3
        - From Docket:  form#Form2

      Detail Panel
      -------------
      Search/Browse filing detail uses: span#cphMain_lbDetails
      Docket filing detail uses:        span#cphMain_lbDetails2

      Both have the same internal HTML structure with 3 tables:

      Table 1 — Case Title:
        &lt;table width="100%"&gt;
          &lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;font size="3"&gt;&lt;center&gt;Party Name, Role,&lt;/center&gt;&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;font size="2"&gt;&lt;center&gt;v.&lt;/center&gt;&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;b&gt;&lt;font size="3"&gt;&lt;center&gt;Other Party, Role.&lt;/center&gt;&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;/table&gt;

      Table 2 — Metadata (label/value rows):
        &lt;table width="100%"&gt;
          &lt;tr valign="top"&gt;&lt;/tr&gt;                                  (empty spacer)
          &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Argument Date:&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;MM/DD/YYYY&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Decision Date:&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;MM/DD/YYYY&lt;/td&gt;&lt;/tr&gt;   (decided only)
          &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Opinion By:&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Judge Name&lt;/td&gt;&lt;/tr&gt;      (decided only)
          &lt;tr&gt;&lt;td&gt;&lt;strong&gt;Official Citation:&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;43 NY3d 1049&lt;/td&gt;&lt;/tr&gt; (decided only)
        &lt;/table&gt;

      Table 3 — Issues:
        &lt;table width="100%"&gt;
          &lt;tr&gt;&lt;td&gt;&lt;font size="4"&gt;&lt;strong&gt;Issues&lt;/strong&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;font size="3"&gt;&lt;strong&gt;Category--Subcategory&lt;/strong&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;td&gt;&lt;font size="2"&gt;Issue description text.&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;
          (may repeat category + description pairs)
        &lt;/table&gt;

      After the tables, free text:
        "The following documents are currently available for download."
        "Additional documents may be available at a later date."

      Files Table: table#cphMain_gvFiles
      -----------------------------------
      Header row: "Files Available For Download:" | "Select"
      Data rows:
        td[0]: File name (in span#cphMain_gvFiles_lbFileName_N)
        td[1]: Either:
          - Download button: input[type="submit"][name="ctl00$cphMain$gvFiles$ctl{NN}$bttnDownload"]
          - "Not Available": span#cphMain_gvFiles_lbSealed_N with text "Not Available"

      Button name pattern: ctl00$cphMain$gvFiles$ctl{02+N}$bttnDownload
        where N is the 0-based row index, offset starts at ctl02 for the first data row.
        Note: ctl08 is skipped for sealed files (no button emitted), so the ctl numbers
        may have gaps.

      Navigation buttons:
        Search flow:  ctl00$cphMain$bttnSearch ("Return to Search")
                      ctl00$cphMain$bttnResults ("Return to Results")
        Browse flow:  ctl00$cphMain$Button2 ("Return to Search")
                      ctl00$cphMain$bttnResults ("Return to Results")
        Docket flow:  ctl00$cphMain$bttnDocketDetails ("Return to Docket")
                      ctl00$cphMain$bttnResultsDetails ("Return to Results")

      Scraper XPath Assertions
      ========================
      1. CASE_NAME (table 1): //span[@id='cphMain_lbDetails']/table[1]//center//text()
         - min_count: 0
      2. ALL_TEXT (metadata): //span[@id='cphMain_lbDetails']//text()
         - min_count: 0
         - Regex extraction: "Argument Date:\s*(\d{2}/\d{2}/\d{4})"
         -                   "Decision Date:\s*(\d{2}/\d{2}/\d{4})"
         -                   "Opinion By:\s*(.+?)(?=\s*Official Citation:|\s*Issues\b|$)"
         -                   "Official Citation:\s*(.+?)(?=\s*Reported Below:|\s*Issues\b|$)"
      3. ISSUE_CATEGORIES: //span[@id='cphMain_lbDetails']//strong//text()
         - min_count: 0
         - Filter: text containing "--" is an issue category
      4. ISSUE_DESCRIPTIONS: //span[@id='cphMain_lbDetails']/table[last()]//font[@size='2']
         - min_count: 0
      5. FILE_ROWS: //table[contains(@id, 'gvFiles')]//tr[position()>1]
         - min_count: 0
      6. DOWNLOAD_BUTTON: .//input[@type='submit']
         - min_count: 0 (per file row)

      For docket filing detail (parse_docket_filing_detail), replace
      'cphMain_lbDetails' with 'cphMain_lbDetails2' in all XPaths above.
      The structure is identical.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="html">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="head" minOccurs="0"/>
        <xs:element name="body" type="bodyType"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="bodyType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Form ID varies by entry path:
      Search:  Form1
      Browse:  Form3
      Docket:  Form2
  -->
  <!--
    Form contains: hidden <input> fields, detail <span>, files <table>,
    and navigation <input> buttons.  Uses xs:any because <input> appears
    in two roles (hidden fields and nav buttons), violating UPA.
  -->
  <xs:complexType name="aspnetFormType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="formIdType"/>
    <xs:attribute name="method" fixed="post"/>
  </xs:complexType>

  <xs:simpleType name="formIdType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Form1"/>
      <xs:enumeration value="Form2"/>
      <xs:enumeration value="Form3"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Detail panel: span#cphMain_lbDetails (or #cphMain_lbDetails2 from docket)
    Contains 3 tables: title, metadata, issues
  -->
  <xs:complexType name="detailPanelType">
    <xs:sequence>
      <xs:element name="hr" minOccurs="0"/>
      <xs:element name="table" type="titleTableType"/>
      <xs:element name="hr" minOccurs="0"/>
      <xs:element name="table" type="metadataTableType"/>
      <xs:element name="br" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="table" type="issuesTableType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="detailSpanIdType"/>
  </xs:complexType>

  <xs:simpleType name="detailSpanIdType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="cphMain_lbDetails"/>
      <xs:enumeration value="cphMain_lbDetails2"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Table 1: Case title with <center> elements -->
  <xs:complexType name="titleTableType">
    <xs:sequence>
      <xs:element name="tr" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="td">
              <xs:complexType mixed="true">
                <xs:sequence>
                  <xs:element name="b" minOccurs="0">
                    <xs:complexType mixed="true">
                      <xs:sequence>
                        <xs:element name="font" minOccurs="0">
                          <xs:complexType mixed="true">
                            <xs:sequence>
                              <xs:element name="center" type="xs:string" minOccurs="0"/>
                            </xs:sequence>
                            <xs:attribute name="size" type="xs:string"/>
                          </xs:complexType>
                        </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="width" fixed="100%"/>
  </xs:complexType>

  <!-- Table 2: Metadata rows with <strong>Label:</strong> / value -->
  <xs:complexType name="metadataTableType">
    <xs:sequence>
      <xs:element name="tr" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="td" maxOccurs="2">
              <xs:complexType mixed="true">
                <xs:sequence>
                  <xs:element name="font" minOccurs="0">
                    <xs:complexType mixed="true">
                      <xs:sequence>
                        <xs:element name="strong" type="xs:string" minOccurs="0"/>
                      </xs:sequence>
                      <xs:attribute name="size" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
                <xs:attribute name="width" type="xs:string" use="optional"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="valign" type="xs:string" use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="width" fixed="100%"/>
  </xs:complexType>

  <!-- Table 3: Issues — category in <strong>, description in <font size="2"> -->
  <xs:complexType name="issuesTableType">
    <xs:sequence>
      <!-- First row: "Issues" header -->
      <xs:element name="tr" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="td">
              <xs:complexType mixed="true">
                <xs:sequence>
                  <xs:element name="font" minOccurs="0">
                    <xs:complexType mixed="true">
                      <xs:sequence>
                        <xs:element name="strong" type="xs:string" minOccurs="0"/>
                      </xs:sequence>
                      <xs:attribute name="size" type="xs:string"/>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="width" fixed="100%"/>
  </xs:complexType>

  <!--
    Files GridView: table#cphMain_gvFiles

    Row types:
      - Header row: <tr> with <th> cells ("Files Available For Download:" | "Select")
      - Data rows:  <tr> with <td> cells (file name in <span>, download button or "Not Available")
    Uses single <tr> element to satisfy UPA.
  -->
  <xs:complexType name="filesGridType">
    <xs:sequence>
      <xs:element name="tr" type="filesRowType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" fixed="cphMain_gvFiles"/>
  </xs:complexType>

  <!-- Flexible row type for files grid -->
  <xs:complexType name="filesRowType">
    <xs:sequence>
      <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
</xs:schema>
